{
  "manifest_version": 3,
  "name": "Synapse - ContextRelay",
  "version": "1.0.0",
  "description": "Synapse ContextRelay Chrome Extension",

  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://*/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Synapse - ContextRelay"
  }
}
